# Copy to .env on the server only. Never commit real secrets.
# HTTPS address supplied by the hosting service, without a trailing slash.
LEDGER_URL=
# Generate once with: openssl rand -hex 32
LEDGER_SECRET_KEY=
# Supabase OAuth Server confidential client (NOT the publishable/service role key).
LEDGER_OAUTH_CLIENT_ID=
LEDGER_OAUTH_CLIENT_SECRET=
