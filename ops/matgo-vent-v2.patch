+   if(url.origin!=='https://fixture.test'||['/config.js','/matgo-access.js'].includes(url.pathname))return route.fulfill({contentType:'text/javascript',body:''});
+   if(!fs.existsSync(file))return route.fulfill({status:404,body:''});
