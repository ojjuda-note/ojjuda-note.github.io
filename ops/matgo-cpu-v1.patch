new file mode 100644
index 0000000..0222fb0
--- /dev/null
+++ b/games/matgo-opponent.css
@@ -0,0 +1,16 @@
+.zone.op .who b.cpu-opponent{min-width:0;max-width:56%;gap:8px;overflow:visible}
+.zone.op .who b.cpu-opponent:before{display:none}
+.cpu-name{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;line-height:1.5}
+.cpu-name small{display:block;font-size:10px;color:#d8c7a1;font-weight:400}
+.cpu-portrait{position:relative;display:block;flex:0 0 72px;width:72px;height:78px;overflow:hidden;border:1px solid #d7b57799;border-radius:19px;background:radial-gradient(ellipse at 50% 25%,#71608d,#312440 80%);box-shadow:inset 0 0 0 2px #ffffff0b,0 4px 10px #0004;isolation:isolate;pointer-events:none}
+.cpu-portrait img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;object-position:center bottom;filter:drop-shadow(0 1px 2px #0005)}
+.cpu-face-surprised{opacity:0}
+.matgo-cpu-surprised .cpu-portrait .cpu-face-normal{opacity:0}
+.matgo-cpu-surprised .cpu-portrait .cpu-face-surprised{opacity:1}
+.matgo-cpu-surprised .cpu-portrait{border-color:#ffe18f;background:radial-gradient(ellipse at 50% 25%,#af714f,#493044 85%)}
+@media(max-width:360px),(max-height:640px){
+  .cpu-portrait{flex-basis:58px;width:58px;height:62px;border-radius:16px}
+  .zone.op .who b.cpu-opponent{gap:5px;max-width:54%}
+  .cpu-name{font-size:11px}
+}
+.matgo-short .cpu-portrait{flex-basis:52px;width:52px;height:56px;border-radius:14px}
